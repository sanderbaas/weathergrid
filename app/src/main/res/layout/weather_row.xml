            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="8.5sp" />
        <TextView
            android:id="@+id/precip1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#88CCFF"
            android:textSize="8.5sp" />
    </LinearLayout>

